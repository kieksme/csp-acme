# Lokale Acme-Demo: cp .env.example .env
# Branding und Plugins stehen in portal.config.json.
# Fiktive Daten, keine Provider-Zugangsdaten erforderlich.
CSP_DEMO=true
CSP_BASE_PATH=/
CSP_API_URL=http://localhost:3001
CSP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
CSP_PORT=3001
CSP_HOST=127.0.0.1
# pnpm dev:ollama verwendet diese Werte für echte lokale Antworten.
# CSP_CHAT_DEMO=false aktiviert nur den echten Chat bei CSP_DEMO=true.
CSP_CHAT_PROVIDER=ollama
CSP_CHAT_MODEL=llama3.2
CSP_CHAT_OLLAMA_URL=http://localhost:11434

# Für langsame lokale Modelle: bis zu 300000 ms, Standard 60000.
# CSP_CHAT_TIMEOUT_MS=180000
