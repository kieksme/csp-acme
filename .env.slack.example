# Acme: API-runtime only; generate portal.support.json with pnpm setup:slack.
CSP_CONFIG_PATH=portal.support.json
# API-Runtime only. Profile requires chatSupport.mode=slack and plugin-slack.
# Keep provider configuration; secrets belong in the API host's secret store.
CSP_SLACK_ENABLED=true
CSP_SLACK_DEMO=false
CSP_CHAT_RETENTION_DAYS=30
CSP_CHAT_DATABASE_URL=postgresql://REPLACE_WITH_SECRET_REFERENCE
CSP_SLACK_BOT_TOKEN=xoxb-REPLACE_WITH_SECRET_REFERENCE
CSP_SLACK_SIGNING_SECRET=REPLACE_WITH_SECRET_REFERENCE
CSP_SLACK_APP_ID=REPLACE_WITH_SLACK_APP_ID
CSP_SLACK_TEAM_ID=REPLACE_WITH_WORKSPACE_ID
CSP_SLACK_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID
CSP_SLACK_SUPPORT_USER_IDS=REPLACE_WITH_COMMA_SEPARATED_USER_IDS

# Open website: no Microsoft login required. Keep the signing key in runtime secrets.
CSP_SLACK_AUTH=anonymous
CSP_CHAT_SESSION_SECRET=<random-64-hex-characters>
