{
  "schemaVersion": 1,
  "id": "acme",
  "branding": {
    "name": "Acme Service Portal",
    "tagline": "Acme. Wir halten Ihren Betrieb am Laufen.",
    "description": "Das zentrale Kundenportal für Acme: Support, Ansprechpartner, Systemstatus und Serviceinformationen.",
    "logoFile": "public/acme-logo.svg",
    "iconFile": "public/acme-icon.svg"
  },
  "theme": {
    "mode": "system",
    "tokens": {
      "accent": "#f97316",
      "hero": "#111827"
    }
  },
  "contact": {
    "phone": "+49 000 000000",
    "label": "Acme Support-Hotline"
  },
  "public": {
    "apiUrl": "http://localhost:3001",
    "basePath": "/",
    "demo": true,
    "staticDemo": false,
    "pollMs": 60000
  },
  "contentFile": "content.json",
  "plugins": [
    "@kieksme/csp-plugin-contact",
    "@kieksme/csp-plugin-signl4",
    "@kieksme/csp-plugin-kuma",
    "@kieksme/csp-plugin-content",
    "@kieksme/csp-plugin-chat",
    "@kieksme/csp-plugin-slack",
    "@kieksme/csp-plugin-swetrix"
  ],
  "avatarsFile": "avatars.json",
  "chatSupport": {
    "mode": "demo"
  },
  "analytics": {
    "swetrix": {
      "projectId": "QKIxNNebrjFs",
      "apiUrl": "https://analytics-api.kieks.me/log",
      "enabled": true,
      "variant": "support-demo",
      "respectDNT": true
    }
  }
}
