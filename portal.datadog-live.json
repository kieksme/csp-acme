{
  "schemaVersion": 1,
  "id": "acme",
  "branding": {
    "name": "Acme Service Portal",
    "tagline": "Acme. Wir halten Ihren Betrieb am Laufen.",
    "description": "Acme Web-Services: Datadog Health, SLOs und Bereitschaften.",
    "logoFile": "public/acme-logo.svg",
    "iconFile": "public/acme-icon.svg"
  },
  "theme": {
    "mode": "system",
    "tokens": {
      "accent": "#f97316",
      "hero": "#111827"
    }
  },
  "contact": {
    "phone": "+49 000 000000",
    "label": "Acme Support-Hotline"
  },
  "public": {
    "basePath": "/",
    "apiUrl": "http://127.0.0.1:3039",
    "domain": "http://127.0.0.1:5173",
    "pollMs": 60000,
    "demo": false,
    "staticDemo": false
  },
  "contentFile": "content.json",
  "plugins": [
    "@kieksme/csp-plugin-contact",
    "@kieksme/csp-plugin-datadog",
    "@kieksme/csp-plugin-content"
  ],
  "avatarsFile": "avatars.json"
}
