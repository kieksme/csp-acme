# API-Runtime: als .env auf dem API-Host verwenden, niemals committen.
# Alle Provider-Adressen, Team-IDs, Hotline und Schlüssel ersetzen.
CSP_DEMO=false
CSP_HOST=0.0.0.0
CSP_PORT=3001
CSP_ALLOWED_ORIGINS=https://portal.acme.example
CSP_API_URL=https://api.acme.example
CSP_CONTACT_PHONE=+49 000 000000
CSP_SIGNL4_API_KEY=replace-with-signl4-read-key
CSP_SIGNL4_TEAM_ID=replace-with-acme-team-id
CSP_SIGNL4_TIMEZONE=Europe/Berlin
CSP_SIGNL4_HORIZON_DAYS=7
CSP_KUMA_URL=https://status.acme.example
CSP_KUMA_SLUG=acme
CSP_CHAT_PROVIDER=ollama
CSP_CHAT_MODEL=llama3.2
CSP_CHAT_OLLAMA_URL=http://ollama:11434
# Alternativ OpenAI: CSP_CHAT_PROVIDER=openai, CSP_CHAT_MODEL und CSP_CHAT_OPENAI_API_KEY
# Alternativ Azure: CSP_CHAT_PROVIDER=azure, CSP_CHAT_MODEL=Deployment-Name,
# CSP_CHAT_AZURE_ENDPOINT und CSP_CHAT_AZURE_API_KEY
CSP_CHAT_RATE_LIMIT=10
CSP_CHAT_CONCURRENCY=2
CSP_CHAT_MAX_TOKENS=1024
