# Nur fuer eine eigene Datadog-API-Runtime, niemals in den Frontend-Build laden.
# Als .env.local in einer separaten Instanz verwenden und leere Werte ergaenzen.
CSP_DEMO=false
CSP_HOST=0.0.0.0
CSP_PORT=3039
CSP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSP_CONTACT_PHONE=+49 000 000000
CSP_DATADOG_SITE=datadoghq.eu
CSP_DATADOG_API_KEY=
CSP_DATADOG_APP_KEY=
CSP_DATADOG_CASE_PROJECT_ID=dbca84fb-e14c-4936-b6ed-4987cf61f60d
CSP_DATADOG_MONITOR_IDS=127595870,127596025
CSP_DATADOG_SLO_IDS=e5ce1645100459fba2d1aa3f372ab630
CSP_DATADOG_SCHEDULE_IDS=ae0208c7-4a47-4884-9649-3341d3ea14a5,91767f1b-af0a-4e0d-8984-9220158856c9

# MCP am API-Host (Runtime, kein Frontend-Build)
CSP_MCP_ENABLED=true
# CSP_MCP_TOKEN: eigenes Runtime-Secret mit mindestens 32 Zeichen
