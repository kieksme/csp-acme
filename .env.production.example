# Öffentliche Frontend-Konfiguration: als .env.production kopieren.
# Platzhalter durch echte Kundenadressen ersetzen. KEINE Secrets eintragen.
# Demo-.env vorher entfernen; der API-Service hat eine separate Runtime-Konfiguration.
CSP_DEMO=false
CSP_BASE_PATH=/
CSP_DOMAIN=https://portal.acme.example
CSP_API_URL=https://api.acme.example
# Beispiel Naming-Override (überschreibt portal.config.json):
CSP_NAME=Acme Customer Service
CSP_TAGLINE=Ihr direkter Draht zum Acme Service-Team.
CSP_CONTACT_PHONE=+49 000 000000
# Optional: CSP_LOGO_URL=https://cdn.acme.example/logo.svg
# Für Hosting unter /csp-acme/ stattdessen CSP_BASE_PATH=/csp-acme/ setzen.
# Das mitgelieferte Logo folgt automatisch dem Basispfad.
