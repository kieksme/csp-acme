{
  "name": "csp-acme",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "csp validate",
    "dev": "csp dev",
    "build": "csp build",
    "start": "csp start",
    "start:api": "csp start",
    "build:demo": "csp build --config portal.demo.json --production",
    "check": "csp validate && csp validate --config portal.demo.json --production && csp build && csp build --config portal.demo.json --production"
  },
  "dependencies": {
    "@kieksme/csp-core": "0.6.0",
    "@kieksme/csp-plugin-contact": "0.6.0",
    "@kieksme/csp-plugin-content": "0.6.0",
    "@kieksme/csp-plugin-chat": "0.6.0",
    "@kieksme/csp-sdk": "0.6.0",
    "@kieksme/csp-plugin-signl4": "0.6.0",
    "@kieksme/csp-plugin-kuma": "0.6.0"
  },
  "devDependencies": {
    "@kieksme/csp-cli": "0.6.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.8.1",
  "files": [
    "dist-api",
    "portal.config.json",
    "portal.demo.json",
    "content.json",
    "public",
    "avatars.json",
    "design-system"
  ],
  "version": "1.2.0",
