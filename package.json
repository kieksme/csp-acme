{
  "name": "csp-acme",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "csp validate",
    "dev": "CSP_DEMO=true CSP_CHAT_DEMO=true CSP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 csp dev",
    "build": "csp build",
    "start": "csp start",
    "start:api": "csp start",
    "build:demo": "csp build --config portal.demo.json --production",
    "check": "csp validate && csp validate --config portal.demo.json --production && csp build && csp build --config portal.demo.json --production && csp validate --config portal.hosted.json --production && csp build --config portal.hosted.json --production && csp validate --config portal.support-demo.json && csp build --config portal.support-demo.json",
    "dev:ollama": "CSP_DEMO=true CSP_CHAT_DEMO=false CSP_CHAT_PROVIDER=ollama CSP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 csp dev",
    "build:hosted": "csp build --config portal.hosted.json --production",
    "dev:support": "CSP_DEMO=true CSP_CHAT_DEMO=true CSP_SLACK_DEMO=true CSP_SLACK_ENABLED=false CSP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 csp dev --config portal.support-demo.json",
    "build:support-demo": "csp build --config portal.support-demo.json",
    "setup:slack": "node scripts/setup-slack.mjs",
    "build:support": "csp build --config portal.support.json --production"
  },
  "dependencies": {
    "@kieksme/csp-core": "0.9.0",
    "@kieksme/csp-plugin-contact": "0.9.0",
    "@kieksme/csp-plugin-content": "0.9.0",
    "@kieksme/csp-plugin-chat": "0.9.0",
    "@kieksme/csp-sdk": "0.9.0",
    "@kieksme/csp-plugin-signl4": "0.9.0",
    "@kieksme/csp-plugin-kuma": "0.9.0",
    "@kieksme/csp-plugin-slack": "0.9.0"
  },
  "devDependencies": {
    "@kieksme/csp-cli": "0.9.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.8.1",
  "files": [
    "dist-api",
    "portal.config.json",
    "portal.demo.json",
    "content.json",
    "public",
    "avatars.json",
    "design-system",
    "portal.hosted.json",
    "portal.support-demo.json",
    "portal.support.json"
  ],
  "version": "1.2.0",
  "csp": {
    "stylesheet": "design-system/portal.css"
  }
}
